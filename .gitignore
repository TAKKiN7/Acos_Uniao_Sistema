# ==============================================================================
# .gitignore - AÇOS UNIÃO MANAGER (Python + CustomTkinter)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Byte-compiled / Optimized / Native modules (Python Cache)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo

# Caches de teste e cobertura
.cache
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 2. Virtual Environments (Ambientes Virtuais Python)
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/
share/

# ------------------------------------------------------------------------------
# 3. Empacotamento & Compilação (PyInstaller, Build, Dist)
# ------------------------------------------------------------------------------
build/
dist/
*.manifest
*.spec
*.exe
*.msi
*.deb
*.rpm
*.zip
*.tar.gz
*.7z

# ------------------------------------------------------------------------------
# 4. Configurações de IDEs e Editores de Código
# ------------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm / JetBrains
.idea/
*.iws
*.iml
*.ipr

# Sublime Text / Atom / outros
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# ------------------------------------------------------------------------------
# 5. Variáveis de Ambiente, Segredos e Senhas
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
secrets.json
credentials.json
*.pem
*.key
*.crt

# ------------------------------------------------------------------------------
# 6. Logs, Temporários e Cache de Execução
# ------------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
scratch/

# ------------------------------------------------------------------------------
# 7. Arquivos Locais de SO (Windows e macOS)
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# ------------------------------------------------------------------------------
# 8. Arquivos Locais de Teste e XMLs Baixados (NFe / CTe temporários)
# ------------------------------------------------------------------------------
*.xml
*.pdf
*.xlsx
*.csv
!templates/
